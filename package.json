{
  "name": "ice-breaker-ts",
  "version": "1.0.0",
  "description": "LinkedIn ice breaker tool - Node.js/TypeScript/Serverless v4",
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "sls package",
    "deploy:dev": "sls deploy --stage dev",
    "deploy:prod": "sls deploy --stage prod",
    "e2e": "npx ts-node scripts/e2e.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "serverless": "^4.40.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.5": true,
    "serverless@4.40.0": true
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@aws-sdk/client-sqs": "^3.1095.0",
    "@upstash/redis": "^1.38.0",
    "ai": "^7.0.37",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
